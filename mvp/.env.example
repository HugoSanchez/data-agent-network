# Anthropic API key (required for LLM-powered intent matching)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# HMAC secret for MPP payment challenge verification (any random string)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPP_SECRET_KEY=your-random-hex-string-here

# Persistent wallet keys for Tempo testnet (optional — generated automatically if not set)
# Generate with: cd mvp && node --import=tsx/esm -e "import {generatePrivateKey} from 'viem/accounts'; console.log(generatePrivateKey())"
PROVIDER_PRIVATE_KEY=0x...
REQUESTER_PRIVATE_KEY=0x...
